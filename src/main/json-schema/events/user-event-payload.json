{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridehub.com/schemas/events/user-event-payload.json",
  "title": "UserEventPayload",
  "description": "Schema cho payload bên trong EventEnvelope khi eventName = user.*",
  "type": "object",
  "properties": {
    "id": { "type": "integer", "format": "int64" },
    "keycloakId": { "type": "string", "format": "uuid" },
    "email": { "type": "string", "format": "email" },
    "phoneNumber": { "type": ["string", "null"] },
    "firstName": { "type": ["string", "null"] },
    "lastName": { "type": ["string", "null"] },
    "dateOfBirth": { "type": ["string", "null"], "format": "date" },
    "isVerified": { "type": ["boolean", "null"] },
    "isActive": { "type": "boolean" },
    "lastLoginAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "allOf": [
    { "$ref": "../common/audit-fields.json" }
  ],
  "required": ["keycloakId", "email", "isActive", "createdAt"]
}
