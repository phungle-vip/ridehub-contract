{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridehub.com/schemas/events/booking-event-payload.json",
  "title": "BookingEventPayload",
  "description": "Schema cho payload bên trong EventEnvelope khi eventName = booking.*",
  "type": "object",
  "properties": {
    "id": { "type": "integer", "format": "int64" },
    "bookingCode": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["PENDING", "CONFIRMED", "CANCELLED", "COMPLETED", "EXPIRED", "REFUNDED"],
      "description": "Trạng thái booking"
    },
    "quantity": { "type": ["integer", "null"] },
    "totalAmount": { "type": "number", "description": "Tổng tiền booking" },
    "bookedAt": { "type": "string", "format": "date-time" },
    "customerId": { "type": "string", "format": "uuid" },
    "idempotencyKey": { "type": ["string", "null"], "maxLength": 80 },
    "tripId": { "type": "integer", "format": "int64" },
    "lockGroupId": { "type": ["string", "null"], "maxLength": 36 },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" },
    "timeoutMinutes": { "type": ["integer", "null"] }
  },
  "allOf": [
    { "$ref": "../common/audit-fields.json" }
  ],
  "required": ["bookingCode", "status", "totalAmount", "bookedAt", "customerId", "tripId", "createdAt"]
}
